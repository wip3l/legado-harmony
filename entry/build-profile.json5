{
  "apiType": "stageMode",
  "buildOption": {
    "sourceOption": {
      "workers": ["./src/main/ets/workers/ComicColorWorker.ets"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest"
    }
  ],
  "buildModeBinder": [
    {
      "buildModeName": "release",
      "mappings": [
        {
          "targetName": "default",
          "buildOptionName": "release"
        }
      ]
    }
  ]
}
